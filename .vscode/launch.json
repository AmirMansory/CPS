{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run CPS Project",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/CPS4042.exe",   // adjust if the exe name differs
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw1310_64/bin/gdb.exe",   // path to gdb in your MinGW install
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build with CMake"   // this will trigger the build task we define next
        }
    ]
}